# ==============================================================================
# Weddings Vision Redesign - Environment Variables Template
# ==============================================================================

# Client-Side Razorpay Key ID (Public key for checkout popup)
# In Test Mode: rzp_test_... | In Live Mode: rzp_live_...
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder_key

# Serverless Functions Razorpay Credentials (Private key for /api/create-order and /api/verify-payment)
RAZORPAY_KEY_ID=rzp_test_placeholder_key
RAZORPAY_KEY_SECRET=rzp_test_placeholder_secret

# Optional: Razorpay Webhook Secret for signature validation
RAZORPAY_WEBHOOK_SECRET=

# Contact Hotline Configuration
VITE_CONTACT_PHONE=+919929252073
VITE_CONTACT_EMAIL=info@weddingsvision.com
